 }
+
+uint64
+sys_trace(void)
+{
+  int mask;
+  argint(0, &mask);
+  myproc()->trace_mask = mask;
+  return 0;
+}
+
+uint64
+sys_history(void)
+{
+  int sys_num;
+  uint64 st_addr;
+
+  argint(0, &sys_num);
+  argaddr(1, &st_addr);
+
+  struct syscall_stat stat;
+  if(get_syscall_stat(sys_num, &stat) < 0){
+    return -1;
+  }
+
+  struct proc *p = myproc();
+  if(copyout(p->pagetable, st_addr, (char *)&stat, sizeof(stat)) < 0){
+    return -1;
+  }
+
+  return 0;
+}
diff --git a/user/history.c b/user/history.c
new file mode 100644
index 0000000..3dad479
--- /dev/null
+++ b/user/history.c
@@ -0,0 +1,34 @@
+#include "kernel/param.h"
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/syscall_stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  struct syscall_stat stat;
+
+  if(argc == 2){
+    int sys_num = atoi(argv[1]);
+    if(history(sys_num, &stat) < 0){
+      fprintf(2, "history: failed to get stat for syscall %d\n", sys_num);
+      exit(1);
+    }
+    printf("%d: syscall: %s, #: %d, time: %d\n", sys_num, stat.syscall_name, stat.count, stat.accum_time);
+  }
+  else if(argc == 1){
+    for(int i = 1; ; i++){
+      if(history(i, &stat) < 0){
+        break;
+      }
+      printf("%d: syscall: %s, #: %d, time: %d\n", i, stat.syscall_name, stat.count, stat.accum_time);
+    }
+  }
+  else{
+    fprintf(2, "Usage: history [sys_call_num]\n");
+    exit(1);
+  }
+
+  exit(0);
+}
