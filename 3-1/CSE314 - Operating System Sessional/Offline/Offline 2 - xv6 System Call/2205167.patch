@@ -6,6 +6,25 @@
 #include "proc.h"
 #include "syscall.h"
 #include "defs.h"
+#include "syscall_stat.h"
+
+#define MAX_SYSCALLS 32
+
+struct {
+  struct spinlock lock;
+  int count;
+  int accum_time;
+} syscall_stats[MAX_SYSCALLS];
+
+void
+syscall_stat_init(void)
+{
+  for(int i = 0; i < MAX_SYSCALLS; i++){
+    initlock(&syscall_stats[i].lock, "syscall_stat");
+    syscall_stats[i].count = 0;
+    syscall_stats[i].accum_time = 0;
+  }
+}
 
 // Fetch the uint64 at addr from the current process.
 int
@@ -101,6 +120,8 @@ extern uint64 sys_unlink(void);
 extern uint64 sys_link(void);
 extern uint64 sys_mkdir(void);
 extern uint64 sys_close(void);
+extern uint64 sys_trace(void);
+extern uint64 sys_history(void);
 
 // An array mapping syscall numbers from syscall.h
 // to the function that handles the system call.
@@ -126,8 +147,163 @@ static uint64 (*syscalls[])(void) = {
 [SYS_link]    sys_link,
 [SYS_mkdir]   sys_mkdir,
 [SYS_close]   sys_close,
+[SYS_trace]   sys_trace,
+[SYS_history] sys_history,
+};
+
+static char *syscall_names[] = {
+[SYS_fork]    "fork",
+[SYS_exit]    "exit",
+[SYS_wait]    "wait",
+[SYS_pipe]    "pipe",
+[SYS_read]    "read",
+[SYS_kill]    "kill",
+[SYS_exec]    "exec",
+[SYS_fstat]   "fstat",
+[SYS_chdir]   "chdir",
+[SYS_dup]     "dup",
+[SYS_getpid]  "getpid",
+[SYS_sbrk]    "sbrk",
+[SYS_sleep]   "sleep",
+[SYS_uptime]  "uptime",
+[SYS_open]    "open",
+[SYS_write]   "write",
+[SYS_mknod]   "mknod",
+[SYS_unlink]  "unlink",
+[SYS_link]    "link",
+[SYS_mkdir]   "mkdir",
+[SYS_close]   "close",
+[SYS_trace]   "trace",
+[SYS_history] "history",
 };
 
+int
+get_syscall_stat(int sys_num, struct syscall_stat *stat)
+{
+  if(sys_num <= 0 || sys_num >= NELEM(syscalls) || !syscalls[sys_num]){
+    return -1;
+  }
+
+  acquire(&syscall_stats[sys_num].lock);
+  stat->count = syscall_stats[sys_num].count;
+  stat->accum_time = syscall_stats[sys_num].accum_time;
+  release(&syscall_stats[sys_num].lock);
+
+  safestrcpy(stat->syscall_name, syscall_names[sys_num], sizeof(stat->syscall_name));
+  return 0;
+}
+
+void
+print_syscall_args(int num)
+{
+  switch (num) {
+    case SYS_fork:
+    case SYS_getpid:
+    case SYS_uptime:
+      printf("()");
+      break;
+
+    case SYS_exit:
+    case SYS_kill:
+    case SYS_sbrk:
+    case SYS_sleep:
+    case SYS_close:
+    case SYS_trace:
+    case SYS_dup: {
+      int arg0;
+      argint(0, &arg0);
+      printf("(%d)", arg0);
+      break;
+    }
+
+    case SYS_wait:
+    case SYS_pipe: {
+      uint64 addr;
+      argaddr(0, &addr);
+      printf("(%p)", (void*)addr);
+      break;
+    }
+
+    case SYS_exec: {
+      char path[MAXPATH];
+      uint64 argv;
+      argstr(0, path, MAXPATH);
+      argaddr(1, &argv);
+      printf("(%s, %p)", path, (void*)argv);
+      break;
+    }
+
+    case SYS_open: {
+      char path[MAXPATH];
+      int omode;
+      argstr(0, path, MAXPATH);
+      argint(1, &omode);
+      printf("(%s, %d)", path, omode);
+      break;
+    }
+
+    case SYS_read:
+    case SYS_write: {
+      int fd, n;
+      uint64 buf;
+      argint(0, &fd);
+      argaddr(1, &buf);
+      argint(2, &n);
+      printf("(%d, %p, %d)", fd, (void*)buf, n);
+      break;
+    }
+
+    case SYS_fstat: {
+      int fd;
+      uint64 st;
+      argint(0, &fd);
+      argaddr(1, &st);
+      printf("(%d, %p)", fd, (void*)st);
+      break;
+    }
+
+    case SYS_chdir:
+    case SYS_mkdir:
+    case SYS_unlink: {
+      char path[MAXPATH];
+      argstr(0, path, MAXPATH);
+      printf("(%s)", path);
+      break;
+    }
+
+    case SYS_mknod: {
+      char path[MAXPATH];
+      int major, minor;
+      argstr(0, path, MAXPATH);
+      argint(1, &major);
+      argint(2, &minor);
+      printf("(%s, %d, %d)", path, major, minor);
+      break;
+    }
+
+    case SYS_link: {
+      char old_path[MAXPATH], new_path[MAXPATH];
+      argstr(0, old_path, MAXPATH);
+      argstr(1, new_path, MAXPATH);
+      printf("(%s, %s)", old_path, new_path);
+      break;
+    }
+
+    case SYS_history: {
+      int sys_num;
+      uint64 st_addr;
+      argint(0, &sys_num);
+      argaddr(1, &st_addr);
+      printf("(%d, %p)", sys_num, (void*)st_addr);
+      break;
+    }
+
+    default:
+      printf("()");
+      break;
+  }
+}
