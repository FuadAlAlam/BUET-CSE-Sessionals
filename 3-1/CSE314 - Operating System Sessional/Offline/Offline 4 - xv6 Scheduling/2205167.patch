diff --git a/user/dummyproc.c b/user/dummyproc.c
new file mode 100644
index 0000000..dc7a7e7
--- /dev/null
+++ b/user/dummyproc.c
@@ -0,0 +1,60 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+static uint64
+atou64(const char *s)
+{
+  uint64 n = 0;
+  while(*s >= '0' && *s <= '9'){
+    n = n * 10 + (*s - '0');
+    s++;
+  }
+  return n;
+}
+
+int
+main(int argc, char *argv[])
+{
+  if(argc < 3){
+    fprintf(2, "Usage: dummyproc <tickets> <iterations>\n");
+    exit(1);
+  }
+
+  int tickets = atoi(argv[1]);
+  uint64 iters = atou64(argv[2]);
+
+  if(settickets(tickets) < 0){
+    fprintf(2, "dummyproc: settickets %d failed\n", tickets);
+    exit(1);
+  }
+
+  int pid = fork();
+  if(pid < 0){
+    fprintf(2, "dummyproc: fork failed\n");
+    exit(1);
+  }
+
+  if(pid == 0){
+    uint64 sleep_interval = 10000000;
+    if(iters < 50000000)
+      sleep_interval = iters / 5 > 0 ? iters / 5 : 100000;
+
+    volatile uint64 sum = 0;
+    for(uint64 i = 0; i < iters; i++){
+      sum += i;
+      if(i > 0 && (i % sleep_interval) == 0){
+        sleep(1);
+      }
+    }
+    exit(0);
+  } else {
+    volatile uint64 sum = 0;
+    for(uint64 i = 0; i < iters; i++){
+      sum += i;
+    }
+    wait(0);
+  }
+
+  exit(0);
+}
diff --git a/user/testprocinfo.c b/user/testprocinfo.c
new file mode 100644
index 0000000..6544adc
--- /dev/null
+++ b/user/testprocinfo.c
@@ -0,0 +1,36 @@
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "kernel/pstat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  struct pstat st;
+
+  if(getpinfo(&st) < 0){
+    fprintf(2, "testprocinfo: getpinfo failed\n");
+    exit(1);
+  }
+
+  printf("PID\tIn Use\tIn Q\tWaiting\tRunning\tTimes\tOrig.\tCurr.\tq0\tq1\n");
+  printf("\t\t\ttime\ttime\tsched.\ttix\ttix\tticks\tticks\n");
+
+  for(int i = 0; i < NPROC; i++){
+    if(st.pid[i] == 0)
+      continue;
+    printf("%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
+           st.pid[i],
+           st.inuse[i],
+           st.inQ[i],
+           st.waiting_time[i],
+           st.running_time[i],
+           st.times_scheduled[i],
+           st.tickets_original[i],
+           st.tickets_current[i],
+           st.queue_ticks[i][0],
+           st.queue_ticks[i][1]);
+  }
+
+  exit(0);
+}
