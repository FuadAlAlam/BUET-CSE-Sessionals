+void
+update_aging(void)
+{
+  struct proc *p;
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+    if(p->state == RUNNABLE){
+      p->waiting_time++;
+      if(p->inQ == 1 && p->waiting_time >= WAIT_THRESH){
+        int waited = p->waiting_time;
+        p->inQ = 0;
+        p->waiting_time = 0;
+        p->time_slices = 0;
+        if(print_logs){
+          printf("BOOST: Process %d (%s) waited for %d ticks, promoted to queue 0\n", p->pid, p->name, waited);
+        }
+      }
+    }
+    release(&p->lock);
+  }
+}
+
+int
+settickets(int number)
+{
+  struct proc *p = myproc();
+  acquire(&p->lock);
+  if(number < 1){
+    p->tickets_original = DEFAULT_TICKETS;
+    p->tickets_current = DEFAULT_TICKETS;
+    release(&p->lock);
+    return -1;
+  }
+  p->tickets_original = number;
+  p->tickets_current = number;
+  release(&p->lock);
+  return 0;
+}
+
+int
+getpinfo(uint64 addr)
+{
+  struct proc *curr = myproc();
+  struct pstat st;
+  struct proc *p;
+  int i;
+
+  if(addr == 0)
+    return -1;
+
+  memset(&st, 0, sizeof(st));
+
+  for(i = 0; i < NPROC; i++){
+    p = &proc[i];
+    acquire(&p->lock);
+    if(p->state != UNUSED){
+      st.pid[i] = p->pid;
+      st.inuse[i] = (p->state == RUNNING) ? 1 : 0;
+      st.inQ[i] = p->inQ;
+      st.waiting_time[i] = p->waiting_time;
+      st.running_time[i] = p->time_slices;
+      st.times_scheduled[i] = p->times_scheduled;
+      st.tickets_original[i] = p->tickets_original;
+      st.tickets_current[i] = p->tickets_current;
+      st.queue_ticks[i][0] = p->queue_ticks[0];
+      st.queue_ticks[i][1] = p->queue_ticks[1];
+    }
+    release(&p->lock);
+  }
+
+  if(copyout(curr->pagetable, addr, (char *)&st, sizeof(st)) < 0)
+    return -1;
+
+  return 0;
+}
