0010 0000 0111 1111 : addi $sp, $zero, 15
0010 0000 0101 0101 : addi $t0, $zero, 5
0010 0000 0001 0011 : addi $t1, $zero, 3
1110 0101 0001 0010 : sub $t2, $t0, $t1
0100 0101 0001 0011 : and $t3, $t0, $t1
1000 0011 0011 0110 : ori $t3, $t3, 6
0000 0101 0101 0001 : srl $t0, $t0, 1
1010 0010 0101 0001 : beq $t0, $t2, matched
1001 0001 0010 0000 : j end_program
0101 0000 0011 0100 : sw $t3, 4($zero)
0011 0000 0100 0100 : lw $t4, 4($zero)
0101 0111 0100 0000 : sw $t4, 0($sp)
0001 0111 0111 0001 : subi $sp, $sp, 1
0010 0111 0111 0001 : addi $sp, $sp, 1
0011 0111 0001 0000 : lw $t1, 0($sp)
1101 0000 0001 0001 : bneq $t1, $zero, skip
0111 0001 0010 0101 : add $t0, $t1, $t2
1011 0001 0101 0100 : nor $t4, $t1, $t0
1001 0001 0010 0000 : j end_program
